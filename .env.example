# Copy to .env.local and fill in. Never commit real keys — .env* is gitignored except this file.

# MongoDB Atlas. Enable encryption at rest on the cluster and restrict network access by
# IP allowlist; the connection string alone is not the security boundary.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="visa_portal"

# Clerk, from its dashboard → API keys. The publishable key is not a secret; the secret
# key is, and must never reach the browser.
#
# Deliberately NOT named NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY: anything with that prefix is
# inlined into the JavaScript bundle when the image is built, which would bake one
# environment's key into it. Passed as a prop to <ClerkProvider> instead, so it is read
# at run time and the same image works anywhere.
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Signs the view-as cookie. Any long random string: `openssl rand -base64 32`.
AUTH_SECRET=""

# Resend, for notification emails only — Clerk sends its own sign-in codes. With
# RESEND_API_KEY empty, notifications are written to the server log instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Passport Portal <portal@yourdomain.com>"

# Where the portal lives, used for the links inside notification emails. The public URL
# people type — the reverse proxy's address, not the container's port. Also editable in
# the notification settings screen, which wins over this.
APP_URL="https://portal.yourdomain.com"
