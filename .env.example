# Copy to .env.local and fill in. Never commit real keys — .env* is gitignored except this file.

# MongoDB Atlas. Enable encryption at rest on the cluster and restrict network access by
# IP allowlist; the connection string alone is not the security boundary.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="visa_portal"

# Peppers the OTP and session hashes. Any long random string: `openssl rand -base64 32`.
AUTH_SECRET=""

# Resend. Leave RESEND_API_KEY empty in development and sign-in codes are printed to the
# server console instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="Passport Portal <portal@yourdomain.com>"

# Where the portal lives, used for the links inside notification emails. The public URL
# people type — the reverse proxy's address, not the container's port. Also editable in
# the notification settings screen, which wins over this.
APP_URL="https://portal.yourdomain.com"
